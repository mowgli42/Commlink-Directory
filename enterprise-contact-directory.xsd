<?xml version="1.0" encoding="UTF-8"?>
<!--
  Enterprise Contact Directory — XML Schema Definition (XSD)
  Version: 1.1 (backward compatible with 1.0 contact-only files)
  
  This schema defines the structure for the Enterprise Contact Directory
  XML data format used to distribute organisational address-book data
  including VoIP phone settings, XMPP chat configuration, and custom
  network services across site, mobile, and aircraft platforms.

  Usage:
    Reference this schema in an XML instance document with:
    <EnterpriseContactDirectory
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="enterprise-contact-directory.xsd"
        exported="2026-02-06T12:00:00.000Z"
        version="1.0">
      ...
    </EnterpriseContactDirectory>
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified">

  <!-- ============================================================
       Root element
       ============================================================ -->
  <xs:element name="EnterpriseContactDirectory">
    <xs:annotation>
      <xs:documentation>
        Root element containing all contact entries in the directory.
        Attributes carry export metadata.
      </xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <!-- v1.1: contacts may be grouped under Contacts -->
        <xs:element name="Contacts" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Contact" type="ContactType" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <!-- v1.0: contacts may appear directly under the root -->
        <xs:element name="Contact" type="ContactType" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="Resources" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Resource" type="ResourceType" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="Contracts" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Contract" type="ContractType" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="CommLinks" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="CommLink" type="CommLinkType" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="Reservations" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Reservation" type="ReservationType" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="exported" type="xs:dateTime" use="required">
        <xs:annotation>
          <xs:documentation>ISO 8601 timestamp of when this file was exported.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="version" type="xs:string" use="required">
        <xs:annotation>
          <xs:documentation>Schema version identifier ("1.0" or "1.1").</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>

  <!-- ============================================================
       Contact
       ============================================================ -->
  <xs:complexType name="ContactType">
    <xs:annotation>
      <xs:documentation>
        A single directory entry representing a person, station, vehicle,
        or aircraft endpoint with its associated communication services.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Name" type="xs:string">
        <xs:annotation>
          <xs:documentation>Human-readable display name (must be unique across directory).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Location"   type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Physical location or deployment description.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Department" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Organisational department or unit.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Notes"      type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Free-text notes or remarks.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="CreatedAt"  type="xs:dateTime" minOccurs="0">
        <xs:annotation>
          <xs:documentation>ISO 8601 timestamp when the contact was first created.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="UpdatedAt"  type="xs:dateTime" minOccurs="0">
        <xs:annotation>
          <xs:documentation>ISO 8601 timestamp of the most recent modification.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Position"        type="PositionType"       minOccurs="0"/>
      <xs:element name="Capabilities"    type="CapabilitiesType"   minOccurs="0"/>
      <xs:element name="VoIP"            type="VoIPType"           minOccurs="0"/>
      <xs:element name="XMPP"            type="XMPPType"           minOccurs="0"/>
      <xs:element name="CustomServices"  type="CustomServicesType" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation>
          Globally unique identifier for this contact.
          Format: UUID or human-readable slug (e.g. "c001-ops-center-alpha").
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="platform" type="PlatformType" use="required">
      <xs:annotation>
        <xs:documentation>Deployment platform category.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <!-- ============================================================
       Platform enumeration
       ============================================================ -->
  <xs:simpleType name="PlatformType">
    <xs:annotation>
      <xs:documentation>
        Allowed platform categories:
          site     — Fixed installation (building, office, data centre)
          mobile   — Ground-based mobile unit (vehicle, portable kit)
          aircraft — Airborne platform (fixed-wing, rotary, UAV)
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="site"/>
      <xs:enumeration value="mobile"/>
      <xs:enumeration value="aircraft"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ============================================================
       VoIP settings
       ============================================================ -->
  <xs:complexType name="VoIPType">
    <xs:annotation>
      <xs:documentation>
        Voice-over-IP endpoint configuration including signalling
        address, codec, protocol, and transport settings.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="IP" type="IPv4AddressType">
        <xs:annotation>
          <xs:documentation>IPv4 address of the VoIP endpoint (must be unique across directory).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Port" type="PortType" default="5060">
        <xs:annotation>
          <xs:documentation>Signalling port number (default: 5060).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Extension" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>PBX extension number.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Codec" type="VoIPCodecType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Preferred audio codec.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Protocol" type="VoIPProtocolType" default="SIP">
        <xs:annotation>
          <xs:documentation>Signalling protocol.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Transport" type="TransportType" default="UDP">
        <xs:annotation>
          <xs:documentation>Network transport for signalling.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:simpleType name="VoIPCodecType">
    <xs:annotation>
      <xs:documentation>Supported audio codecs for VoIP endpoints.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="G.711u"/>   <!-- G.711 µ-law (PCMU) -->
      <xs:enumeration value="G.711a"/>   <!-- G.711 A-law (PCMA) -->
      <xs:enumeration value="G.722"/>    <!-- Wideband 7 kHz -->
      <xs:enumeration value="G.729"/>    <!-- Low-bitrate 8 kbps -->
      <xs:enumeration value="Opus"/>     <!-- Adaptive wideband -->
      <xs:enumeration value="iLBC"/>     <!-- Internet Low Bitrate -->
      <xs:enumeration value="Speex"/>    <!-- Open-source codec -->
      <xs:enumeration value="AMR"/>      <!-- Adaptive Multi-Rate -->
      <xs:enumeration value="AMR-WB"/>   <!-- AMR Wideband -->
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="VoIPProtocolType">
    <xs:annotation>
      <xs:documentation>Supported VoIP signalling protocols.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="SIP"/>    <!-- Session Initiation Protocol -->
      <xs:enumeration value="H.323"/>  <!-- ITU-T H.323 -->
      <xs:enumeration value="IAX2"/>   <!-- Inter-Asterisk Exchange v2 -->
      <xs:enumeration value="SCCP"/>   <!-- Skinny Client Control Protocol -->
    </xs:restriction>
  </xs:simpleType>

  <!-- ============================================================
       XMPP / Chat settings
       ============================================================ -->
  <xs:complexType name="XMPPType">
    <xs:annotation>
      <xs:documentation>
        XMPP (Jabber) instant-messaging and presence configuration
        for the contact's chat endpoint.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="JID" type="xs:string">
        <xs:annotation>
          <xs:documentation>Jabber ID (bare JID), e.g. user@chat.example.com</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Server" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>XMPP server hostname.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="IP" type="IPv4AddressType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>IPv4 address of the XMPP server.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Port" type="PortType" default="5222">
        <xs:annotation>
          <xs:documentation>Client-to-server port (default: 5222).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Encryption" type="EncryptionType" default="STARTTLS">
        <xs:annotation>
          <xs:documentation>Connection encryption mode.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Conference" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>MUC (Multi-User Chat) room JID, e.g. ops@conference.example.com</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:simpleType name="EncryptionType">
    <xs:annotation>
      <xs:documentation>XMPP connection encryption modes.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="STARTTLS"/>     <!-- Upgrade plaintext to TLS -->
      <xs:enumeration value="Direct TLS"/>   <!-- Immediate TLS on connect -->
      <xs:enumeration value="None"/>         <!-- No encryption (not recommended) -->
    </xs:restriction>
  </xs:simpleType>

  <!-- ============================================================
       Custom Services
       ============================================================ -->
  <xs:complexType name="CustomServicesType">
    <xs:annotation>
      <xs:documentation>
        Container for one or more custom network services associated
        with this contact (e.g. monitoring dashboards, SATCOM links).
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Service" type="ServiceType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ServiceType">
    <xs:annotation>
      <xs:documentation>A single custom network service entry.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="ServiceName" type="xs:string">
        <xs:annotation>
          <xs:documentation>Short display name for the service.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="IP" type="IPv4AddressType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>IPv4 address of the service endpoint.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Port" type="PortType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>TCP/UDP port of the service.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Description" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Human-readable description of the service purpose.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <!-- ============================================================
       Shared simple types
       ============================================================ -->
  <xs:simpleType name="IPv4AddressType">
    <xs:annotation>
      <xs:documentation>
        IPv4 dotted-decimal address (0.0.0.0 – 255.255.255.255).
        Each IP should be unique within a given service type across
        the entire directory to avoid conflicts.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="((25[0-5]|2[0-4]\d|[01]?\d?\d)\.){3}(25[0-5]|2[0-4]\d|[01]?\d?\d)"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="PortType">
    <xs:annotation>
      <xs:documentation>Network port number (1–65535).</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:positiveInteger">
      <xs:minInclusive value="1"/>
      <xs:maxInclusive value="65535"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TransportType">
    <xs:annotation>
      <xs:documentation>Network transport layer protocol.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="UDP"/>
      <xs:enumeration value="TCP"/>
      <xs:enumeration value="TLS"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ============================================================
       v1.1 — Position, capabilities, scheduling sections
       ============================================================ -->
  <xs:complexType name="PositionType">
    <xs:attribute name="lat" type="xs:decimal" use="required"/>
    <xs:attribute name="lon" type="xs:decimal" use="required"/>
    <xs:attribute name="alt_m" type="xs:decimal" use="optional"/>
  </xs:complexType>

  <xs:complexType name="CapabilitiesType">
    <xs:sequence>
      <xs:element name="Capability" type="CapabilityType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="CapabilityType">
    <xs:attribute name="kind" type="xs:string" use="required"/>
    <xs:attribute name="resourceRef" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="ResourceType">
    <xs:sequence>
      <xs:element name="Name" type="xs:string" minOccurs="0"/>
      <xs:element name="Owner" type="xs:string" minOccurs="0"/>
      <xs:element name="Capacity" type="CapacityType" minOccurs="0"/>
      <xs:element name="Availability" type="AvailabilityType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
    <xs:attribute name="kind" type="xs:string" use="required"/>
    <xs:attribute name="provider" type="xs:string" use="optional"/>
    <xs:attribute name="status" type="xs:string" use="optional"/>
  </xs:complexType>

  <xs:complexType name="CapacityType">
    <xs:attribute name="bandwidth_khz" type="xs:decimal" use="optional"/>
    <xs:attribute name="channels" type="xs:positiveInteger" use="optional"/>
    <xs:attribute name="maxConcurrentLinks" type="xs:positiveInteger" use="optional"/>
    <xs:attribute name="coverageArea" type="xs:string" use="optional"/>
  </xs:complexType>

  <xs:complexType name="AvailabilityType">
    <xs:attribute name="start" type="xs:dateTime" use="required"/>
    <xs:attribute name="end" type="xs:dateTime" use="required"/>
    <xs:attribute name="recurrence" type="xs:string" use="optional"/>
  </xs:complexType>

  <xs:simpleType name="BillingModelType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="subscription"/>
      <xs:enumeration value="owned"/>
      <xs:enumeration value="pay_per_minute"/>
      <xs:enumeration value="pay_per_mb"/>
      <xs:enumeration value="reservation"/>
      <xs:enumeration value="hybrid"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="ContractType">
    <xs:sequence>
      <xs:element name="Included" type="IncludedType" minOccurs="0"/>
      <xs:element name="IncludedData" type="IncludedDataType" minOccurs="0"/>
      <xs:element name="Overage" type="OverageType" minOccurs="0"/>
      <xs:element name="OverageData" type="OverageType" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
    <xs:attribute name="resourceRef" type="xs:string" use="required"/>
    <xs:attribute name="billingModel" type="BillingModelType" use="required"/>
    <xs:attribute name="label" type="xs:string" use="required"/>
    <xs:attribute name="priorityClass" type="xs:string" use="optional"/>
  </xs:complexType>

  <xs:complexType name="IncludedType">
    <xs:attribute name="minutes" type="xs:positiveInteger" use="optional"/>
    <xs:attribute name="data_mb" type="xs:positiveInteger" use="optional"/>
  </xs:complexType>

  <xs:complexType name="IncludedDataType">
    <xs:attribute name="data_mb" type="xs:positiveInteger" use="required"/>
  </xs:complexType>

  <xs:complexType name="OverageType">
    <xs:attribute name="rate" type="xs:decimal" use="required"/>
    <xs:attribute name="currency" type="xs:string" use="required"/>
    <xs:attribute name="unit" type="xs:string" use="optional"/>
  </xs:complexType>

  <xs:complexType name="CommLinkType">
    <xs:sequence>
      <xs:element name="Endpoint" type="EndpointType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="Schedule" type="AvailabilityType" minOccurs="0"/>
      <xs:element name="Frequency" type="FrequencyType" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
    <xs:attribute name="type" type="xs:string" use="required"/>
    <xs:attribute name="subtype" type="xs:string" use="optional"/>
    <xs:attribute name="resourceRef" type="xs:string" use="optional"/>
    <xs:attribute name="contractRef" type="xs:string" use="optional"/>
  </xs:complexType>

  <xs:complexType name="EndpointType">
    <xs:attribute name="contactRef" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="FrequencyType">
    <xs:attribute name="value_mhz" type="xs:decimal" use="optional"/>
    <xs:attribute name="bandwidth_khz" type="xs:decimal" use="optional"/>
  </xs:complexType>

  <xs:complexType name="ReservationType">
    <xs:sequence>
      <xs:element name="Window" type="WindowType" minOccurs="0"/>
      <xs:element name="Mission" type="xs:string" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
    <xs:attribute name="resourceRef" type="xs:string" use="required"/>
    <xs:attribute name="linkRef" type="xs:string" use="optional"/>
    <xs:attribute name="status" type="xs:string" use="optional"/>
    <xs:attribute name="priority" type="xs:string" use="optional"/>
  </xs:complexType>

  <xs:complexType name="WindowType">
    <xs:attribute name="start" type="xs:dateTime" use="required"/>
    <xs:attribute name="end" type="xs:dateTime" use="required"/>
  </xs:complexType>

</xs:schema>
